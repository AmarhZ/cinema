{
  "name": "marr-cinema",
  "version": "1.0.0",
  "description": "Website tiketing bioskop — Express, Prisma + PostgreSQL (Neon), QRIS, panel admin, deploy Vercel",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.0",
    "express": "^5.0.0",
    "pg": "^8.0.0",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.0"
  }
}
