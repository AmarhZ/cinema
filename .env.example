# --- Database (Neon) ---------------------------------------------------------
# Dashboard Neon → Connect. Aplikasi memakai koneksi POOLED (host ada "-pooler"),
# migrasi Prisma memakai koneksi DIRECT (tanpa "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Panel admin (/admin) ----------------------------------------------------
ADMIN_PASSWORD="ganti-dengan-kata-sandi-panjang"
# Kunci penanda tangan cookie sesi. Buat: openssl rand -hex 32
SESSION_SECRET="ganti-dengan-string-acak-panjang"

# --- Vercel Cron (membuat jadwal harian otomatis). Buat: openssl rand -hex 24
CRON_SECRET="ganti-dengan-string-acak"

# --- Opsional (nilai awal; bisa diubah dari Admin → Pengaturan) --------------
PORT=3000
